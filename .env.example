# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/vetrota?schema=public"

# NextAuth.js Authentication Configuration
NEXTAUTH_SECRET="your_nextauth_secret_key_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Google Gemini API Key for VetRota AI Assistant
GEMINI_API_KEY="your_gemini_api_key"
